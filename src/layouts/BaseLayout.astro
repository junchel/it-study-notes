---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Seo from "../components/Seo.astro";
import { DEFAULT_LANG, I18N, SUPPORTED_LANGS } from "../utils/i18n";

const { title, description, image, canonical, noIndex = false } = Astro.props;
const t = (key) => I18N[DEFAULT_LANG]?.[key] ?? key;
const i18nPayload = {
  defaultLang: DEFAULT_LANG,
  supported: SUPPORTED_LANGS,
  messages: I18N
};
---

<!doctype html>
<html lang={DEFAULT_LANG}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={title}
      description={description}
      image={image}
      canonical={canonical}
      noIndex={noIndex}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Song+Myung&family=IBM+Plex+Sans+KR:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline define:vars={{ i18nPayload }}>
      window.__SITE_I18N__ = i18nPayload;
    </script>
  </head>
  <body class="page">
    <a class="skip-link" href="#main" data-i18n="skip.content">{t("skip.content")}</a>
    <SiteHeader />
    <main id="main" class="main" data-pagefind-body>
      <slot />
    </main>
    <SiteFooter />
    <script is:inline>
      const i18n = window.__SITE_I18N__;
      if (i18n) {
        const storageKey = "it-study-notes.lang";
        const normalizeLang = (lang) =>
          i18n.supported.includes(lang) ? lang : i18n.defaultLang;
        const format = (template, vars) =>
          template.replace(/\{(\w+)\}/g, (_, key) =>
            Object.prototype.hasOwnProperty.call(vars, key) ? String(vars[key]) : ""
          );
        const resolveText = (lang, key, vars) => {
          const template =
            (i18n.messages[lang] && i18n.messages[lang][key]) ||
            i18n.messages[i18n.defaultLang][key] ||
            "";
          return vars ? format(template, vars) : template;
        };
        const safeParse = (value) => {
          if (!value) return null;
          try {
            return JSON.parse(value);
          } catch {
            return null;
          }
        };
        const applyTranslations = (lang) => {
          const next = normalizeLang(lang);
          document.documentElement.lang = next;
          document.documentElement.dataset.lang = next;
          document.querySelectorAll("[data-i18n]").forEach((el) => {
            const key = el.getAttribute("data-i18n");
            if (!key) return;
            const attr = el.getAttribute("data-i18n-attr");
            const vars = safeParse(el.getAttribute("data-i18n-vars"));
            const text = resolveText(next, key, vars || undefined);
            if (attr) {
              el.setAttribute(attr, text);
            } else {
              el.textContent = text;
            }
          });
          document.querySelectorAll("[data-lang-toggle]").forEach((button) => {
            const value = button.getAttribute("data-lang");
            const isActive = value === next;
            button.setAttribute("aria-pressed", isActive ? "true" : "false");
          });
        };
        const setLanguage = (lang) => {
          const next = normalizeLang(lang);
          try {
            localStorage.setItem(storageKey, next);
          } catch {}
          applyTranslations(next);
          window.dispatchEvent(new CustomEvent("site:lang", { detail: { lang: next } }));
        };
        const initLang = () => {
          let initial = i18n.defaultLang;
          try {
            const stored = localStorage.getItem(storageKey);
            if (stored && i18n.supported.includes(stored)) initial = stored;
          } catch {}
          applyTranslations(initial);
          document.querySelectorAll("[data-lang-toggle]").forEach((button) => {
            button.addEventListener("click", () => {
              const value = button.getAttribute("data-lang");
              if (value) setLanguage(value);
            });
          });
        };
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initLang);
        } else {
          initLang();
        }
      }
    </script>
  </body>
</html>
