<div class="search">
  <label class="search-label" for="search-input">Search IT notes</label>
  <input
    id="search-input"
    class="search-input"
    type="search"
    name="q"
    placeholder="Type to search"
    autocomplete="off"
  />
  <div id="search-status" class="search-status"></div>
  <div id="search-results" class="search-results"></div>
</div>

<script type="module">
  const input = document.getElementById("search-input");
  const resultsEl = document.getElementById("search-results");
  const statusEl = document.getElementById("search-status");
  let pagefind;

  const setStatus = (message) => {
    statusEl.textContent = message;
  };

  const getPagefind = async () => {
    if (pagefind) return pagefind;
    try {
      const mod = await import("/pagefind/pagefind.js");
      pagefind = mod.default || mod;
      return pagefind;
    } catch (err) {
      setStatus("Search index not built yet.");
      return null;
    }
  };

  const renderResults = (items) => {
    if (!items.length) {
      resultsEl.innerHTML = "";
      return;
    }
    resultsEl.innerHTML = items
      .map(
        (item) => `
          <article class="search-result">
            <a href="${item.url}">${item.title}</a>
            <p>${item.excerpt}</p>
          </article>
        `
      )
      .join("");
  };

  const handleSearch = async (query) => {
    if (!query) {
      setStatus("");
      renderResults([]);
      return;
    }
    const pf = await getPagefind();
    if (!pf) return;

    setStatus("Searching...");
    const search = await pf.search(query);
    const data = await Promise.all(search.results.map((r) => r.data()));
    const items = data.map((item) => ({
      url: item.url,
      title: item.meta.title || item.title,
      excerpt: item.excerpt
    }));
    setStatus(`${items.length} result(s)`);
    renderResults(items);
  };

  input?.addEventListener("input", (event) => {
    handleSearch(event.target.value.trim());
  });
</script>
