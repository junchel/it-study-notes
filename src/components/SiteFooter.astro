---
import { DEFAULT_LANG, I18N } from "../utils/i18n";

const t = (key) => I18N[DEFAULT_LANG]?.[key] ?? key;
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="container footer-inner">
    <p data-i18n="footer.copy">{t("footer.copy")}</p>
    <a class="footer-link" href="/rss.xml" data-i18n="footer.rss">{t("footer.rss")}</a>
  </div>
</footer>
