---
import BaseLayout from "../layouts/BaseLayout.astro";
import { DEFAULT_LANG, t as translate } from "../utils/i18n";

const t = (key, vars) => translate(DEFAULT_LANG, key, vars);
---

<BaseLayout title={t("about.meta.title")} description={t("about.meta.description")}>
  <div class="container">
    <section class="hero">
      <span class="hero-badge" data-i18n="about.badge">{t("about.badge")}</span>
      <h1 data-i18n="about.title">{t("about.title")}</h1>
      <p data-i18n="about.lead">{t("about.lead")}</p>
    </section>

    <section class="section">
      <article class="prose">
        <h2 data-i18n="about.workflow.title">{t("about.workflow.title")}</h2>
        <ol>
          <li data-i18n="about.workflow.item1">{t("about.workflow.item1")}</li>
          <li data-i18n="about.workflow.item2">{t("about.workflow.item2")}</li>
          <li data-i18n="about.workflow.item3">{t("about.workflow.item3")}</li>
        </ol>

        <h2 data-i18n="about.search.title">{t("about.search.title")}</h2>
        <p data-i18n="about.search.body">{t("about.search.body")}</p>
      </article>
    </section>
  </div>
</BaseLayout>
