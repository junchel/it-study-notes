---
import BaseLayout from "../layouts/BaseLayout.astro";
import NoteCard from "../components/NoteCard.astro";
import Search from "../components/Search.astro";
import { getCollection } from "astro:content";

const notes = (await getCollection("notes", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 6);
---

<BaseLayout
  title="Home"
  description="A living knowledge base for IT study notes, labs, and references."
>
  <div class="container">
    <section class="hero">
      <span class="hero-badge">IT knowledge base</span>
      <h1>Turn IT study sessions into a searchable, growing library.</h1>
      <p>
        Capture commands, troubleshooting notes, and architectures. Connect related
        ideas and surface them later with fast search.
      </p>
      <div class="hero-actions">
        <a class="button" href="/notes/">Browse notes</a>
        <a class="button secondary" href="/about/">How it works</a>
      </div>
    </section>

    <section class="section">
      <div class="section-title">
        <h2>Search</h2>
      </div>
      <Search />
    </section>

    <section class="section">
      <div class="section-title">
        <h2>Learning paths</h2>
        <a href="/paths/">View paths</a>
      </div>
      <div class="note-grid">
        <article class="note-card">
          <div class="note-card-top">
            <h3 class="note-title">IT foundations</h3>
            <p class="note-description">Linux, Windows, and networking fundamentals.</p>
          </div>
        </article>
        <article class="note-card">
          <div class="note-card-top">
            <h3 class="note-title">DevOps starter</h3>
            <p class="note-description">Docker, CI/CD, and observability basics.</p>
          </div>
        </article>
        <article class="note-card">
          <div class="note-card-top">
            <h3 class="note-title">Cloud & platform</h3>
            <p class="note-description">IAM, cloud networking, and managed services.</p>
          </div>
        </article>
        <article class="note-card">
          <div class="note-card-top">
            <h3 class="note-title">Security essentials</h3>
            <p class="note-description">SSH keys, TLS, and HTTP fundamentals.</p>
          </div>
        </article>
        <article class="note-card">
          <div class="note-card-top">
            <h3 class="note-title">Operations & reliability</h3>
            <p class="note-description">Monitoring and incident response basics.</p>
          </div>
        </article>
        <article class="note-card">
          <div class="note-card-top">
            <h3 class="note-title">Data & storage</h3>
            <p class="note-description">Databases, indexing, and backups.</p>
          </div>
        </article>
        <article class="note-card">
          <div class="note-card-top">
            <h3 class="note-title">System design</h3>
            <p class="note-description">Scalability, caching, and reliability.</p>
          </div>
        </article>
        <article class="note-card">
          <div class="note-card-top">
            <h3 class="note-title">Troubleshooting playbooks</h3>
            <p class="note-description">Repeatable debugging workflows.</p>
          </div>
        </article>
        <article class="note-card">
          <div class="note-card-top">
            <h3 class="note-title">Infrastructure as code</h3>
            <p class="note-description">Terraform and automation basics.</p>
          </div>
        </article>
      </div>
    </section>

    <section class="section">
      <div class="section-title">
        <h2>Latest notes</h2>
        <a href="/notes/">View all</a>
      </div>
      <div class="note-grid">
        {notes.map((note) => (
          <NoteCard note={note} />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
