---
import BaseLayout from "../layouts/BaseLayout.astro";
import NoteCard from "../components/NoteCard.astro";
import Search from "../components/Search.astro";
import { getCollection } from "astro:content";
import { DEFAULT_LANG, t as translate } from "../utils/i18n";
import { PATHS } from "../utils/paths";

const allNotes = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const notes = allNotes.slice(0, 6);
const tagSet = new Set();
allNotes.forEach((note) => {
  if (!note.data.tags) return;
  note.data.tags.forEach((tag) => tagSet.add(tag));
});
const stats = [
  { labelKey: "home.hero.stats.notes", value: allNotes.length },
  { labelKey: "home.hero.stats.tags", value: tagSet.size },
  { labelKey: "home.hero.stats.paths", value: PATHS.length }
];
const heroMetrics = [
  {
    labelKey: "home.hero.metric1.label",
    valueKey: "home.hero.metric1.value",
    bodyKey: "home.hero.metric1.body"
  },
  {
    labelKey: "home.hero.metric2.label",
    valueKey: "home.hero.metric2.value",
    bodyKey: "home.hero.metric2.body"
  },
  {
    labelKey: "home.hero.metric3.label",
    valueKey: "home.hero.metric3.value",
    bodyKey: "home.hero.metric3.body"
  }
];
const quickActions = [
  {
    id: "incident",
    titleKey: "home.execute.incident.title",
    bodyKey: "home.execute.incident.body",
    command: "journalctl -u nginx -n 120 --no-pager",
    href: "/tags/incident-response/",
    ctaKey: "home.execute.incident.cta"
  },
  {
    id: "deploy",
    titleKey: "home.execute.deploy.title",
    bodyKey: "home.execute.deploy.body",
    command: "kubectl rollout status deploy/api -n prod",
    href: "/tags/deployment/",
    ctaKey: "home.execute.deploy.cta"
  },
  {
    id: "security",
    titleKey: "home.execute.security.title",
    bodyKey: "home.execute.security.body",
    command: "sudo ss -tulpen | grep -E ':80|:443|:22'",
    href: "/tags/security/",
    ctaKey: "home.execute.security.cta"
  }
];
const pathLevelCycle = ["foundation", "practical", "advanced"];
const workspaceTreePreview = [
  { key: "home.workspace.snapshot.tree1", depth: 0 },
  { key: "home.workspace.snapshot.tree2", depth: 1 },
  { key: "home.workspace.snapshot.tree3", depth: 2 },
  { key: "home.workspace.snapshot.tree4", depth: 1 }
];
const t = (key, vars) => translate(DEFAULT_LANG, key, vars);
---

<BaseLayout
  title={t("home.meta.title")}
  description={t("home.meta.description")}
>
  <div class="container">
    <section class="hero hero-split hero-shell">
      <div class="hero-copy">
        <span class="hero-badge" data-i18n="home.hero.badge">
          {t("home.hero.badge")}
        </span>
        <div class="hero-title-frame">
          <h1 class="hero-title">
            <span class="hero-title-kicker" data-i18n="home.hero.titleTop">
              {t("home.hero.titleTop")}
            </span>
            <span class="hero-title-emphasis">
              <span class="hero-title-accent" data-i18n="home.hero.titleAccent">
                {t("home.hero.titleAccent")}
              </span>
              <span class="hero-title-rest" data-i18n="home.hero.titleBottom">
                {t("home.hero.titleBottom")}
              </span>
            </span>
          </h1>
          <p class="hero-title-note" data-i18n="home.hero.note">
            {t("home.hero.note")}
          </p>
        </div>
        <p class="hero-body" data-i18n="home.hero.body">{t("home.hero.body")}</p>
        <div class="hero-proof">
          <p class="hero-proof-title" data-i18n="home.hero.proofTitle">{t("home.hero.proofTitle")}</p>
          <ul class="hero-highlights">
            <li data-i18n="home.hero.point1">{t("home.hero.point1")}</li>
            <li data-i18n="home.hero.point2">{t("home.hero.point2")}</li>
            <li data-i18n="home.hero.point3">{t("home.hero.point3")}</li>
          </ul>
          <div class="hero-proof-metrics">
            {heroMetrics.map((metric) => (
              <article class="hero-proof-metric">
                <span class="hero-proof-metric-label" data-i18n={metric.labelKey}>
                  {t(metric.labelKey)}
                </span>
                <strong class="hero-proof-metric-value" data-i18n={metric.valueKey}>
                  {t(metric.valueKey)}
                </strong>
                <p class="hero-proof-metric-body" data-i18n={metric.bodyKey}>
                  {t(metric.bodyKey)}
                </p>
              </article>
            ))}
          </div>
        </div>
        <div class="hero-actions">
          <a class="button" href="/notes/" data-i18n="home.hero.primary">
            {t("home.hero.primary")}
          </a>
          <a class="button secondary" href="/workspace/" data-i18n="home.hero.secondary">
            {t("home.hero.secondary")}
          </a>
        </div>
        <div class="hero-signal-rail">
          <div class="hero-signal-item">
            <span class="hero-signal-label" data-i18n="home.hero.signal1.label">
              {t("home.hero.signal1.label")}
            </span>
            <strong data-i18n="home.hero.signal1.value">{t("home.hero.signal1.value")}</strong>
          </div>
          <div class="hero-signal-item">
            <span class="hero-signal-label" data-i18n="home.hero.signal2.label">
              {t("home.hero.signal2.label")}
            </span>
            <strong data-i18n="home.hero.signal2.value">{t("home.hero.signal2.value")}</strong>
          </div>
          <div class="hero-signal-item">
            <span class="hero-signal-label" data-i18n="home.hero.signal3.label">
              {t("home.hero.signal3.label")}
            </span>
            <strong data-i18n="home.hero.signal3.value">{t("home.hero.signal3.value")}</strong>
          </div>
        </div>
      </div>
      <aside class="hero-panel">
        <div class="hero-panel-card search-card">
          <Search />
        </div>
        <div class="hero-panel-card">
          <div class="hero-stats">
          {stats.map((stat) => (
            <div class="hero-stat">
              <div class="hero-stat-value">{stat.value}</div>
              <div class="hero-stat-label" data-i18n={stat.labelKey}>
                {t(stat.labelKey)}
              </div>
            </div>
          ))}
          </div>
        </div>
        <div class="hero-panel-card command-preview">
          <h2 class="command-preview-title" data-i18n="home.command.title">
            {t("home.command.title")}
          </h2>
          <ul class="command-preview-list">
            <li class="command-preview-item">
              <code class="command-line">curl -I https://example.com</code>
              <p data-i18n="home.command.item1">{t("home.command.item1")}</p>
            </li>
            <li class="command-preview-item">
              <code class="command-line">journalctl -u nginx -n 60 --no-pager</code>
              <p data-i18n="home.command.item2">{t("home.command.item2")}</p>
            </li>
            <li class="command-preview-item">
              <code class="command-line">kubectl get pods -A --field-selector=status.phase!=Running</code>
              <p data-i18n="home.command.item3">{t("home.command.item3")}</p>
            </li>
          </ul>
        </div>
      </aside>
    </section>

    <section class="section home-section">
      <div class="section-title">
        <div class="section-heading">
          <span class="section-kicker" data-i18n="home.section.execute.kicker">{t("home.section.execute.kicker")}</span>
          <h2 data-i18n="home.section.execute">{t("home.section.execute")}</h2>
        </div>
        <a href="/notes/" data-i18n="home.section.execute.link">
          {t("home.section.execute.link")}
        </a>
      </div>
      <div class="home-execution-grid">
        {quickActions.map((action, index) => (
          <article class:list={["home-execution-card", `home-execution-tone-${index + 1}`]}>
            <h3 data-i18n={action.titleKey}>{t(action.titleKey)}</h3>
            <code class="command-line">{action.command}</code>
            <p data-i18n={action.bodyKey}>{t(action.bodyKey)}</p>
            <a class="home-execution-link" href={action.href} data-i18n={action.ctaKey}>
              {t(action.ctaKey)}
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="section home-section">
      <div class="section-title">
        <div class="section-heading">
          <span class="section-kicker" data-i18n="home.section.paths.kicker">{t("home.section.paths.kicker")}</span>
          <h2 data-i18n="home.section.paths">{t("home.section.paths")}</h2>
        </div>
        <a href="/paths/" data-i18n="home.section.paths.link">
          {t("home.section.paths.link")}
        </a>
      </div>
      <div class="path-grid">
        {PATHS.map((path, index) => (
          <article class:list={["path-card", `path-card-tone-${(index % 3) + 1}`]}>
            <span class="path-index">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <span class="path-level" data-i18n={`home.path.level.${pathLevelCycle[index % pathLevelCycle.length]}`}>
                {t(`home.path.level.${pathLevelCycle[index % pathLevelCycle.length]}`)}
              </span>
              <h3 data-i18n={`path.${path.id}.title`}>
                {t(`path.${path.id}.title`)}
              </h3>
              <p data-i18n={`path.${path.id}.desc`}>{t(`path.${path.id}.desc`)}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section home-section">
      <div class="section-title">
        <div class="section-heading">
          <span class="section-kicker" data-i18n="home.section.latest.kicker">{t("home.section.latest.kicker")}</span>
          <h2 data-i18n="home.section.latest">{t("home.section.latest")}</h2>
        </div>
        <a href="/notes/" data-i18n="home.section.latest.link">
          {t("home.section.latest.link")}
        </a>
      </div>
      <div class="note-grid">
        {notes.map((note) => (
          <NoteCard note={note} />
        ))}
      </div>
    </section>

    <section class="section home-section">
      <div class="section-title">
        <div class="section-heading">
          <span class="section-kicker" data-i18n="home.section.workspace.kicker">{t("home.section.workspace.kicker")}</span>
          <h2 data-i18n="home.section.workspace">{t("home.section.workspace")}</h2>
        </div>
        <a href="/workspace/" data-i18n="home.section.workspace.link">
          {t("home.section.workspace.link")}
        </a>
      </div>
      <div class="home-workspace-shell">
        <article class="home-workspace-pane">
          <h3 data-i18n="home.workspace.snapshot.treeTitle">{t("home.workspace.snapshot.treeTitle")}</h3>
          <p data-i18n="home.workspace.snapshot.treeBody">{t("home.workspace.snapshot.treeBody")}</p>
          <ul class="home-workspace-tree">
            {workspaceTreePreview.map((item) => (
              <li class="home-workspace-tree-item" style={`--depth:${item.depth};`}>
                <span data-i18n={item.key}>{t(item.key)}</span>
              </li>
            ))}
          </ul>
        </article>
        <article class="home-workspace-pane">
          <h3 data-i18n="home.workspace.snapshot.flowTitle">{t("home.workspace.snapshot.flowTitle")}</h3>
          <p data-i18n="home.workspace.snapshot.flowBody">{t("home.workspace.snapshot.flowBody")}</p>
          <ol class="home-workspace-flow">
            <li>
              <h4 data-i18n="home.workspace.snapshot.step1.title">{t("home.workspace.snapshot.step1.title")}</h4>
              <p data-i18n="home.workspace.snapshot.step1.body">{t("home.workspace.snapshot.step1.body")}</p>
            </li>
            <li>
              <h4 data-i18n="home.workspace.snapshot.step2.title">{t("home.workspace.snapshot.step2.title")}</h4>
              <p data-i18n="home.workspace.snapshot.step2.body">{t("home.workspace.snapshot.step2.body")}</p>
            </li>
            <li>
              <h4 data-i18n="home.workspace.snapshot.step3.title">{t("home.workspace.snapshot.step3.title")}</h4>
              <p data-i18n="home.workspace.snapshot.step3.body">{t("home.workspace.snapshot.step3.body")}</p>
            </li>
          </ol>
        </article>
      </div>
    </section>
  </div>
</BaseLayout>
