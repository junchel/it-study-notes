---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { slugify } from "../../utils/slugify";
import { DEFAULT_LANG, t as translate } from "../../utils/i18n";

const notes = await getCollection("notes", ({ data }) => !data.draft);
const tagMap = new Map();

notes.forEach((note) => {
  note.data.tags.forEach((tag) => {
    const current = tagMap.get(tag) || 0;
    tagMap.set(tag, current + 1);
  });
});

const tags = Array.from(tagMap.entries()).sort((a, b) => a[0].localeCompare(b[0]));
const t = (key, vars) => translate(DEFAULT_LANG, key, vars);
---

<BaseLayout title={t("tags.meta.title")} description={t("tags.meta.description")}>
  <div class="container">
    <section class="hero">
      <span class="hero-badge" data-i18n="tags.badge">{t("tags.badge")}</span>
      <h1 data-i18n="tags.title">{t("tags.title")}</h1>
      <p data-i18n="tags.lead">{t("tags.lead")}</p>
    </section>

    <section class="section">
      <div class="note-grid">
        {tags.map(([tag, count]) => (
          <article class="note-card">
            <h3 class="note-title">
              <a href={`/tags/${slugify(tag)}/`}>{tag}</a>
            </h3>
            <p
              class="note-description"
              data-i18n="tags.count"
              data-i18n-vars={JSON.stringify({ count })}
            >
              {t("tags.count", { count })}
            </p>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
