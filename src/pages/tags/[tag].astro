---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NoteCard from "../../components/NoteCard.astro";
import { getCollection } from "astro:content";
import { slugify } from "../../utils/slugify";
import { DEFAULT_LANG, t as translate } from "../../utils/i18n";

export async function getStaticPaths() {
  const notes = await getCollection("notes", ({ data }) => !data.draft);
  const tagSet = new Set();

  notes.forEach((note) => {
    note.data.tags.forEach((tag) => tagSet.add(tag));
  });

  return Array.from(tagSet).map((tag) => ({
    params: { tag: slugify(tag) },
    props: {
      tag,
      notes: notes.filter((note) => note.data.tags.includes(tag))
    }
  }));
}

const { tag, notes } = Astro.props;
const sortedNotes = [...notes].sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const t = (key, vars) => translate(DEFAULT_LANG, key, vars);
const pageTitle = t("tag.meta.title", { tag });
const pageDescription = t("tag.meta.description", { tag });
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="container">
    <section class="hero">
      <span class="hero-badge" data-i18n="tag.badge">{t("tag.badge")}</span>
      <h1>{tag}</h1>
      <p data-i18n="tag.count" data-i18n-vars={JSON.stringify({ count: notes.length })}>
        {t("tag.count", { count: notes.length })}
      </p>
    </section>

    <section class="section">
      <div class="note-grid">
        {sortedNotes.map((note) => (
          <NoteCard note={note} />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
