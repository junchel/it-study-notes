---
import BaseLayout from "../layouts/BaseLayout.astro";
import { DEFAULT_LANG, t as translate } from "../utils/i18n";

const t = (key, vars) => translate(DEFAULT_LANG, key, vars);
---

<BaseLayout
  title={t("notfound.meta.title")}
  description={t("notfound.meta.description")}
  noIndex={true}
>
  <div class="container">
    <section class="hero">
      <span class="hero-badge">404</span>
      <h1 data-i18n="notfound.title">{t("notfound.title")}</h1>
      <p data-i18n="notfound.body">{t("notfound.body")}</p>
      <div class="hero-actions">
        <a class="button" href="/" data-i18n="notfound.cta">{t("notfound.cta")}</a>
      </div>
    </section>
  </div>
</BaseLayout>
