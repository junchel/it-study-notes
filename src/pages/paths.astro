---
import BaseLayout from "../layouts/BaseLayout.astro";
import TagList from "../components/TagList.astro";

const paths = [
  {
    title: "IT foundations",
    description: "Build core muscle memory: Linux, Windows, networking, and shell basics.",
    tags: ["it-basics", "linux", "windows", "networking", "cli", "dns", "dhcp"]
  },
  {
    title: "DevOps starter",
    description: "Learn automation, containers, CI/CD, and operational visibility.",
    tags: ["devops", "docker", "kubernetes", "ci-cd", "observability"]
  },
  {
    title: "Cloud & platform",
    description: "Shared cloud patterns: IAM, networking, and managed services.",
    tags: ["cloud", "aws", "azure", "gcp", "iam"]
  },
  {
    title: "Security essentials",
    description: "Lock down access, understand HTTPS, and protect keys.",
    tags: ["security", "ssh", "tls", "http"]
  },
  {
    title: "Operations & reliability",
    description: "Incidents, monitoring, and reliable operations habits.",
    tags: ["operations", "incident-response", "monitoring", "observability", "sre"]
  },
  {
    title: "Data & storage",
    description: "Databases, indexing, and backup fundamentals.",
    tags: ["database", "sql", "backup", "disaster-recovery"]
  },
  {
    title: "System design",
    description: "Scalability, caching, and reliability patterns.",
    tags: ["system-design", "caching", "load-balancing", "messaging", "sre"]
  },
  {
    title: "Troubleshooting playbooks",
    description: "Repeatable incident triage and debugging workflows.",
    tags: ["troubleshooting", "api", "docker", "kubernetes"]
  }
];
---

<BaseLayout title="Paths" description="Suggested learning paths for IT study notes.">
  <div class="container">
    <section class="hero">
      <span class="hero-badge">Learning paths</span>
      <h1>Study paths</h1>
      <p>Pick a track and follow the related tags to build depth.</p>
    </section>

    <section class="section">
      <div class="note-grid">
        {paths.map((path) => (
          <article class="note-card">
            <div class="note-card-top">
              <h3 class="note-title">{path.title}</h3>
              <p class="note-description">{path.description}</p>
            </div>
            <TagList tags={path.tags} />
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
