---
import BaseLayout from "../layouts/BaseLayout.astro";
import TagList from "../components/TagList.astro";
import { DEFAULT_LANG, t as translate } from "../utils/i18n";
import { PATHS } from "../utils/paths";

const t = (key, vars) => translate(DEFAULT_LANG, key, vars);
---

<BaseLayout title={t("paths.meta.title")} description={t("paths.meta.description")}>
  <div class="container">
    <section class="hero">
      <span class="hero-badge" data-i18n="paths.badge">{t("paths.badge")}</span>
      <h1 data-i18n="paths.title">{t("paths.title")}</h1>
      <p data-i18n="paths.lead">{t("paths.lead")}</p>
    </section>

    <section class="section">
      <div class="path-grid">
        {PATHS.map((path, index) => (
          <article class="path-card">
            <span class="path-index">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3 data-i18n={`path.${path.id}.title`}>
                {t(`path.${path.id}.title`)}
              </h3>
              <p data-i18n={`path.${path.id}.desc`}>{t(`path.${path.id}.desc`)}</p>
              <TagList tags={path.tags} />
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
